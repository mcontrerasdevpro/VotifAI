# Base de datos (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Usa false solo si PostgreSQL está aislado en una red privada/VPN sin TLS.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Certificado CA en una sola línea para validar estrictamente el certificado del VPS.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Servidor
PORT=3000
NODE_ENV=development

# Origenes permitidos por CORS (separados por coma si hay varios)
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite) - URL base del API para el proxy en desarrollo
VITE_API_URL=http://localhost:3000

# Autenticación (Fase 1)
JWT_SECRET=changeme_genera_un_secreto_largo_y_aleatorio

# Transcripción de voz real en Junta en Vivo (manos alzadas por móvil)
# Sin esta clave, /api/asistencia/:entityId/voz devuelve un error claro
# en vez de fallar en silencio; el resto de la app funciona igual.
OPENAI_API_KEY=sk-...

# Notificaciones por WhatsApp y email (convocatorias, reenvío de actas)
# Webhook de un workflow de n8n que recibe un JSON con {tipo, despacho,
# finca, mensaje, destinatarios[]} y decide el canal por destinatario
# según tenga teléfono, email, o ambos. Sin esta URL, las notificaciones
# se simulan con un log en consola en vez de fallar — en producción esto
# significa que los propietarios NUNCA reciben la convocatoria ni el acta.
N8N_WEBHOOK_URL=https://tu-instancia-n8n.com/webhook/votifai-notificaciones

# A quién avisar cuando alguien rellena el formulario de demo del landing.
# Sin esta variable, la notificación se dispara igualmente pero sin email
# de destino, así que la solicitud queda solo en la tabla demo_solicitudes.
DEMO_NOTIFICATION_EMAIL=ventas@tudespacho.com

# Facturación (Stripe) — checkout real de los planes de pago
# Sin STRIPE_SECRET_KEY, /api/billing/planes marca disponibleParaCheckout:
# false en todos los planes y nadie puede pagar/actualizar su suscripción.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de precio de Stripe para cada plan de pago (Dashboard > Products).
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESIONAL=price_...
STRIPE_PRICE_PREMIUM=price_...
# Tax rate de Stripe "IVA 21 %" (exclusivo, España). Los precios son sin IVA;
# sin esta variable el checkout queda deshabilitado para no facturar sin IVA.
STRIPE_TAX_RATE_IVA=txr_...
# A dónde vuelve el usuario tras pagar/cancelar en Stripe Checkout.
# Sin definir, se calcula del host de la petición — solo hace falta
# fijarlas si el dominio público difiere del que ve Express.
BILLING_SUCCESS_URL=https://tuapp.com/hub?billing=success
BILLING_CANCEL_URL=https://tuapp.com/hub?billing=cancelled

# Clave para la página de estado (/api/estado-sistema?token=...) y para las
# tareas programadas de n8n (cabecera x-admin-token). Una cadena larga y
# aleatoria; sin ella esas rutas no existen.
ADMIN_TOKEN=
# Email que recibe los avisos de negocio (registros, pagos, cancelaciones).
# Por defecto contacto@nexuraia.com.
ALERTAS_EMAIL=
