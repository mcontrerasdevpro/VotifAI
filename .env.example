# Base de datos (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Servidor
PORT=3000
NODE_ENV=development

# Origenes permitidos por CORS (separados por coma si hay varios)
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite) - URL base del API para el proxy en desarrollo
VITE_API_URL=http://localhost:3000

# Autenticación (Fase 1)
JWT_SECRET=changeme_genera_un_secreto_largo_y_aleatorio

# Transcripción de voz real en Junta en Vivo (manos alzadas por móvil)
# Sin esta clave, /api/asistencia/:entityId/voz devuelve un error claro
# en vez de fallar en silencio; el resto de la app funciona igual.
OPENAI_API_KEY=sk-...

# Notificaciones por WhatsApp y email (convocatorias, reenvío de actas)
# Webhook de un workflow de n8n que recibe un JSON con {tipo, despacho,
# finca, mensaje, destinatarios[]} y decide el canal por destinatario
# según tenga teléfono, email, o ambos. Sin esta URL, las notificaciones
# se simulan con un log en consola en vez de fallar.
N8N_WEBHOOK_URL=https://tu-instancia-n8n.com/webhook/votifai-notificaciones
